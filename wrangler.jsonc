{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-chat",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "type": "javascript",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openapi-template-db"
    }
  ],
  "upload_source_maps": true
}
